{
  "expo": {
    "name": "Patentory",
    "slug": "patent-knowledge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/patentory-icon-v3.png",
    "scheme": "patentknowledge",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.cerensivri.patentknowledge",
      "adaptiveIcon": {
        "backgroundColor": "#071A3D",
        "foregroundImage": "./assets/images/patentory-icon-v3.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/patentory-favicon-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A3D",
          "image": "./assets/images/patentory-splash-v3.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca8a6c0b-a344-4ae0-9158-5c7ce2a748e9"
      }
    },
    "owner": "cernsvr"
  }
}
